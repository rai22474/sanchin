#!/usr/bin/env bash
# Runs the installed Sanchin validator for this project from a shell, Git
# hook or CI job.
#
#   scripts/sanchin check | trust | gates | git-hook | roadmap | superseded ...
#
# Written by the init skill. It finds the validator in this
# order, and runs it with --project set to this repository:
#   1. $SANCHIN                       an explicit path to a scripts/sanchin
#   2. $CLAUDE_PLUGIN_ROOT            inside Claude Code
#   3. .agents/sanchin                in the current or primary Git worktree
#   4. the installed plugin           from Claude Code's plugin registry
#                                     (a project-scoped install for this
#                                     repository first, then any)
#   5. the plugin cache               the newest cached version
set -euo pipefail

project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
plugins_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins"

from_registry() {
  local registry="$plugins_dir/installed_plugins.json"
  [ -f "$registry" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg project "$project_root" '
      [.plugins | to_entries[] | select(.key | startswith("sanchin@")) | .value[]]
      | (map(select(.projectPath == $project)) + .) | .[0].installPath // empty' "$registry"
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$registry" "$project_root" <<'PY'
import json, sys
entries = [e for key, values in json.load(open(sys.argv[1])).get("plugins", {}).items()
           if key.startswith("sanchin@") for e in values]
entries.sort(key=lambda e: e.get("projectPath") != sys.argv[2])
print(entries[0]["installPath"] if entries else "")
PY
  fi
}

from_cache() {
  ls -d "$plugins_dir"/cache/*/sanchin/*/scripts/sanchin 2>/dev/null | sort -V | tail -1
}

primary_worktree() {
  local entry
  IFS= read -r entry < <(git -C "$project_root" worktree list --porcelain 2>/dev/null) || return 0
  case "$entry" in
    'worktree '*) printf '%s\n' "${entry#worktree }" ;;
  esac
}

candidates=()
[ -n "${SANCHIN:-}" ] && candidates+=("$SANCHIN")
[ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && candidates+=("$CLAUDE_PLUGIN_ROOT/scripts/sanchin")
candidates+=("$project_root/.agents/sanchin/scripts/sanchin")
primary=$(primary_worktree)
if [ -n "$primary" ] && [ "$primary" != "$project_root" ]; then
  candidates+=("$primary/.agents/sanchin/scripts/sanchin")
fi
install_path=$(from_registry || true)
[ -n "$install_path" ] && candidates+=("$install_path/scripts/sanchin")
cached=$(from_cache || true)
[ -n "$cached" ] && candidates+=("$cached")

for candidate in "${candidates[@]}"; do
  if [ -x "$candidate" ] && [ ! "$candidate" -ef "${BASH_SOURCE[0]}" ]; then
    exec "$candidate" --project "$project_root" "$@"
  fi
done

echo "sanchin: the validator isn't installed for this project." >&2
echo "  In Claude Code: /plugin install sanchin@sanchin." >&2
echo "  In Codex: run scripts/install-codex-skills from a Sanchin checkout with this project as the target," >&2
echo "  or set SANCHIN=<path to a sanchin checkout>/scripts/sanchin." >&2
exit 2
