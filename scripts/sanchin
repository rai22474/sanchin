#!/usr/bin/env bash
# Run sanchin's validator with a Python that has PyYAML and the Gherkin parser.
# Usage: scripts/sanchin [--project DIR] check|superseded|gates|hook ...
# Prefers uv (no install needed); falls back to a python3 that already has both.
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export PYTHONPATH="$script_dir${PYTHONPATH:+:$PYTHONPATH}"

if command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --no-project --with pyyaml --with gherkin-official==42.0.1 python3 -m sanchin_validator "$@"
fi
exec python3 -m sanchin_validator "$@"
