#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
target_root=$(CDPATH= cd -- "${1:-.}" && pwd -P)
skills_dir="$target_root/.agents/skills"
checkout_link="$target_root/.agents/sanchin"
marker='<!-- Generated by Sanchin install-codex-skills. -->'

conflict() {
    printf 'Refusing to replace existing path: %s\n' "$1" >&2
    exit 1
}

if [ -L "$checkout_link" ]; then
    [ "$(readlink "$checkout_link")" = "$repo_root" ] || conflict "$checkout_link"
elif [ -e "$checkout_link" ]; then
    conflict "$checkout_link"
fi

# Check all destinations before creating or refreshing any entry.
for source in "$repo_root"/skills/*; do
    [ -f "$source/SKILL.md" ] || continue
    name=${source##*/}
    [ "$name" != trust ] || continue
    target="$skills_dir/sanchin-$name"
    if [ -e "$target" ] || [ -L "$target" ]; then
        [ ! -L "$target" ] && [ -f "$target/SKILL.md" ] &&
            [ ! -L "$target/SKILL.md" ] &&
            grep -q -Fx "$marker" "$target/SKILL.md" || conflict "$target"
    fi
done

mkdir -p "$skills_dir"
[ -L "$checkout_link" ] || ln -s "$repo_root" "$checkout_link"
for source in "$repo_root"/skills/*; do
    [ -f "$source/SKILL.md" ] || continue
    name=${source##*/}
    if [ "$name" != trust ]; then
        target="$skills_dir/sanchin-$name"
        mkdir -p "$target"
        {
            # Share discovery metadata with Claude and give Codex a distinct name.
            awk -v name="sanchin-$name" '
                /^---$/ { print; if (++delimiters == 2) exit; next }
                /^name:/ { print "name: " name; next }
                { print }
            ' "$source/SKILL.md"
            printf '\n%s\n\n' "$marker"
            printf '%s\n' "From the project root, resolve .agents/sanchin to the Sanchin checkout."
            printf '%s\n' "Read docs/codex.md (Skill runtime) and skills/$name/SKILL.md from that checkout."
        } > "$target/SKILL.md"
    fi
    # Migrate links made by the earlier installer that point to this checkout.
    legacy="$skills_dir/$name"
    if [ -L "$legacy" ] && [ "$(readlink "$legacy")" = "$source" ]; then
        rm "$legacy"
    fi
done
printf 'Installed Sanchin skills in %s\n' "$skills_dir"
